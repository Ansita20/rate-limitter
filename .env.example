# Copy this file to .env and adjust as needed.
# `node server.js` (and Docker) both read from .env automatically.

# Port the API listens on
PORT=4000

# Redis connection. Local dev default shown below.
# Managed Redis (Upstash, Redis Cloud, AWS ElastiCache, etc.) will give you
# a full connection string to paste here — often starting with rediss://
REDIS_URL=redis://127.0.0.1:6379

# Secret used to sign user session JWTs. MUST be changed to a long random
# value before you put this anywhere near real users.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser,
# e.g. https://myapp.com,https://admin.myapp.com
# Leave unset during development to allow all origins.
# CORS_ORIGIN=https://myapp.com
